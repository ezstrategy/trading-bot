# Copy this file to .env and fill in your values. Never commit .env.
# All credentials are read from the environment only; nothing is hardcoded.

# --- MetaTrader 5 (demo account recommended) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional: full path to terminal64.exe if you run more than one MT5 install
MT5_PATH=

# --- Telegram (signals only) ---
# 1. In Telegram, talk to @BotFather, send /newbot, copy the token below.
# 2. Open your new bot and press Start (or add it to a channel/group as admin).
# 3. Chat id: your user id, or the channel id (starts with -100). Test with:
#    python -m quant_engine telegram-test
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional overrides ---
# QE_CONFIG_DIR=config
# QE_LOG_LEVEL=INFO
